  - m_Id: 37073645041307648
    m_Localized: 'Shockwave

      Gravity Manipulator at lvl 1'
    m_Metadata:
      m_Items: []
  - m_Id: 37073875501535232
    m_Localized: 'Works as a magnet trap, holding units that pass by.

      Has
      a limited energy reserve, that deplenishes with time.

      Move the cursor
      over it to see the indicator.

      Detonates when the energy runs out'
    m_Metadata:
      m_Items: []
