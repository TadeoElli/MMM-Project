  - m_Id: 2212797961687040
    m_Localized: "Energy Consumption: <color=white>250</color>\tDamage:  <color=white>1-800</color>\tVelocity: 
      <color=white>15</color>\tStability:  <color=white>70-95%</color>\tElastic Collision: 
      <color=white>Yes</color>\nSpecial:  <color=white>None</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2213820755300352
    m_Localized: "Energy Consumption: <color=white>200</color>\tDamage:  <color=white>200-800</color>\t  
      Velocity:  <color=white>20</color>       Stability:  <color=white>80-100%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>None</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2218442261745664
    m_Localized: "Energy Consumption: <color=white>550</color>\tDamage:  <color=white>1-1000</color>\t  
      Velocity:  <color=white>30</color>       Stability:  <color=white>50-80%</color>   
      Elastic Collision:  <color=white>Yes</color>\nSpecial:  <color=white>Acceleration
      after each collision with wall or unit</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2219815908888576
    m_Localized: "Energy Consumption: <color=white>300</color>\tDamage:  <color=white>300-1000</color>\t  
      Velocity:  <color=white>23</color>       Stability:  <color=white>40-70%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>Random
      repulsion angle</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2220525148917760
    m_Localized: "Energy Consumption: <color=white>500</color>\tDamage:  <color=white>1-700</color>\t  
      Velocity:  <color=white>10</color>       Stability:  <color=white>15-50%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>Sticks
      to units</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2221809704849408
    m_Localized: "Energy Consumption: <color=white>700</color>\tDamage:  <color=white>3000-4000</color>\t  
      Velocity:  <color=white>25</color>       Stability:  <color=white>15-35%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>Huge damage</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2222390594981888
    m_Localized: "Energy Consumption: <color=white>700</color>\tDamage:  <color=white>0</color>\t  
      Velocity:  <color=white>5</color>       Stability:  <color=white>1-30%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>Pull units
      to it</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 2224171211247616
    m_Localized: "Energy Consumption: <color=white>700</color>\tDamage:  <color=white>1-500</color>\t  
      Velocity:  <color=white>20</color>       Stability:  <color=white>1-40%</color>   
      Elastic Collision:  <color=white>No</color>\nSpecial:  <color=white>Split into
      proyectiles upon collision with units</color>"
    m_Metadata:
      m_Items:
      - rid: 794851374009679874
  - m_Id: 4559885508759552
    m_Localized: 'Enemies come from both sides

      Survive for 3 minutes'
    m_Metadata:
      m_Items: []
  - m_Id: 4687038414016512
    m_Localized: 'The original mode

      The gameplay is divided into 30 waves

      Destroy
      yor enemies, earn experience, upgrade, obtain new abilities

      You can
      save your progress after each wave'
    m_Metadata:
      m_Items: []
  - m_Id: 4693339437223936
    m_Localized: Main Menu
    m_Metadata:
      m_Items: []
  - m_Id: 4698830812958720
    m_Localized: '[ Play ]'
    m_Metadata:
      m_Items: []
  - m_Id: 4704608860983296
    m_Localized: 'Survive for as long as possible

      There are no waves and no
      pause, and you will have to upgrade your launcher fast

      Dont play this
      one if you are new to this game'
    m_Metadata:
      m_Items: []
  - m_Id: 4706149063938048
    m_Localized: Same as Survival but enemiy units will be coming from both sides,
      left and right
    m_Metadata:
      m_Items: []
  - m_Id: 4711861135560704
    m_Localized: Same as survival but no enemy respawn acceleration
    m_Metadata:
      m_Items: []
  - m_Id: 4712646732894208
    m_Localized: 'You have 600 seconds after which your launcher will blow up


      Destroy
      as many enemy units as you can and try not to get killed before the time runs
      out'
    m_Metadata:
      m_Items: []
  - m_Id: 4713835117629440
    m_Localized: 'Do not let any enemy unit slip through!

      You will be able
      to use ONLY antimatter ammo


      Score is time-based'
    m_Metadata:
      m_Items: []
  - m_Id: 6298426718769152
    m_Localized: 'created by:'
    m_Metadata:
      m_Items: []
  - m_Id: 6298615282094080
    m_Localized: 'Original creator:'
    m_Metadata:
      m_Items: []
