    m_Localized: Shockwave Tower
    m_Metadata:
      m_Items: []
  - m_Id: 37077264134262784
    m_Localized: 'Shockwave

      Gravity Manipulator at lvl 2'
    m_Metadata:
      m_Items: []
  - m_Id: 37077459580440576
    m_Localized: 'Draws passing by targets and as they get close activates shockwave
      drive.

      Has a limited energy reserve, that deplenishes with time.

      Move
      the cursor over it to see the indicator.

      Detonates when the energy runs
      out'
    m_Metadata:
      m_Items: []
  - m_Id: 37078337989332992
