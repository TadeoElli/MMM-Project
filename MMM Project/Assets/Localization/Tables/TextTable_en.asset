    m_Metadata:
      m_Items: []
  - m_Id: 37078622136651776
    m_Localized: 'Energy upgrade at lvl 5

      Stability upgrade at lvl 10

      Shockwave'
    m_Metadata:
      m_Items: []
  - m_Id: 37078866882678784
    m_Localized: 'Generates an energy field that affects your projectiles. Making
      them orbit the tower and accelerating them.

      Has a limited energy reserve,
      that deplenishes when any projectiles are in effect.

      Move the cursor
      over it to see the indicator.

      Detonates when the energy runs out'
    m_Metadata:
      m_Items: []
  - m_Id: 37080829754036224
